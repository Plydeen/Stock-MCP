MASSIVE_API_KEY=
MASSIVE_S3_ACCESS_KEY=
MASSIVE_S3_SECRET_KEY=
MASSIVE_API_BASE_URL=https://api.massive.com
MASSIVE_S3_ENDPOINT=https://files.massive.com
MASSIVE_S3_BUCKET=flatfiles
MCP_PORT=8082
MAX_CSV_ROWS=5000
FLAT_FILE_CACHE_DIR=/tmp/massive-flat-cache
FLAT_FILE_CACHE_TTL_HOURS=24
CLOUDFLARE_TUNNEL_TOKEN=
PUBLIC_MCP_HOSTNAME=mcp.kowens.tech
# Auth mode: oauth (Claude Custom Connectors), basic (Traefik htpasswd overlay), none (local only)
MCP_AUTH_MODE=none
MCP_PUBLIC_BASE_URL=https://mcp.kowens.tech
MCP_OAUTH_PROVIDER=github
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
# Optional: stable signing key so OAuth client registrations survive container restarts
MCP_OAUTH_JWT_SIGNING_KEY=
# htpasswd format; escape $ as $$ in docker-compose (only used with deploy/docker-compose.basic-auth.yml)
MCP_BASIC_AUTH_USERS=
